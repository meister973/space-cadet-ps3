// Positions arrive in screen pixels. projection holds (2/width, -2/height, -1, 1).
void main(float2 position : POSITION,
          float2 texcoord : TEXCOORD0,
          uniform float4 projection,
          out float4 out_position : POSITION,
          out float2 out_texcoord : TEXCOORD0)
{
    out_position = float4(position.x * projection.x + projection.z,
                          position.y * projection.y + projection.w, 0.0, 1.0);
    out_texcoord = texcoord;
}
